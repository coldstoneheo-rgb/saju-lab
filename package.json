{
  "name": "saju-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Report-first Four Pillars analysis workspace.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "collect:solar-terms": "python scripts/collect_public_data_solar_terms.py",
    "verify": "npm run typecheck && npm test && npm run build && npm audit --audit-level=moderate && git diff --check",
    "diff:cross-impl": "node scripts/diff_cross_impl.mjs",
    "golden:strength-pack": "node scripts/strength_verify_pack.mjs",
    "typecheck": "tsc -p api/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test:api && npm run test --workspaces --if-present",
    "test:api": "vitest run api"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "astronomia": "4.2.0",
    "lunar-typescript": "1.8.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
